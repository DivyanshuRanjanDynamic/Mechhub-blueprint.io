{
  "name": "mechhub-blueprint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MechHub Blueprint: turn a hardware idea into a parts list, wiring diagram, 3D CAD model, firmware and assembly guide.",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx server/selftest.ts",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:mock-groq": "tsx scripts/e2e.ts --mock-groq"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "groq-sdk": "^1.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}

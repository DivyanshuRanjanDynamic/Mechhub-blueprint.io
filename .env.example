# Planner backend: groq | claude | offline.
# If this is left unset, a GROQ_API_KEY selects Groq, an Anthropic key selects Claude,
# and with neither key the offline planner is used.
# MECHHUB_PROVIDER=groq

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# PORT=8787
